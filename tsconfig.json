{
  // TypeScript is a DEV-TIME dependency only. Nothing here runs at request
  // time or at deploy time — `noEmit` is set and no bundler is wired up yet.
  // At this stage the only inputs are the generated declarations in
  // src/types/, so this config exists to prove they compile under `strict`.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2022 for the library surface (not the emit target — tsc never emits).
    // The test suite uses Array.prototype.at, which is ES2022; every runtime
    // this code reaches has it (Node 22 here, and Vite's default browser
    // target is well past it). `target` stays ES2020.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Modules import each other by server-root-absolute URL (`from
    // '/expr.js'`) — the paths the Python server used to serve them from.
    // Vite maps those to src/ via a resolver plugin (vite.config.mts); this
    // teaches tsc the same mapping so the two agree.
    // (TypeScript 7 removed `baseUrl`; path targets must be relative.)
    "paths": { "/*": ["./src/*"] },

    // tsc never emits. It is the correctness gate; anything that eventually
    // needs emitting will be emitted by the bundler, not by tsc.
    "noEmit": true,
    "isolatedModules": true,

    // Incremental migration: the .js sources under src/ ride along unchecked
    // until converted file-by-file in later phases. `checkJs` flips on in the
    // final phase, once nothing is left in JavaScript.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true,
    // `node` is here for the test suite: src/*.test.ts import node:test and
    // node:assert/strict, which need @types/node in the program.
    //
    // This DOES put Node's globals (process, Buffer, __dirname) in scope for
    // application code too, which is a real if mild loosening — app modules
    // run in the browser and have no business touching them. It is not
    // avoidable per-file: a triple-slash `/// <reference types="node" />`
    // registers program-wide, not file-locally (measured, not assumed), so
    // scoping it to the tests would need a second tsconfig for a payoff that
    // does not justify the machinery.
    "types": ["node"]
  },
  "include": ["src"]
}
