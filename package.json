{
  "name": "algebench",
  "private": true,
  "type": "module",
  "description": "Tooling/test harness for AlgeBench static ES modules (no build step).",
  "scripts": {
    "test": "node --experimental-strip-types --import ./scripts/register-test-resolver.mjs --test src/*.test.js",
    "types:generate": "node scripts/generate_ts_types.mjs",
    "types:check": "node scripts/generate_ts_types.mjs --check",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/three": "0.137.0",
    "json-schema-to-typescript": "^15.0.4",
    "marked": "12.0.0",
    "mathjs": "13.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
