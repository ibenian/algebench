{
  "name": "default-light",
  "mode": "light",
  "direction": "LR",
  "labelMode": "emoji",
  "nodeStyles": {
    "scalar":   { "shape": "rect",    "fill": "#eaf2ec", "stroke": "#4c7a58", "color": "#24402c" },
    "vector":   { "shape": "rect",    "fill": "#eaf2ec", "stroke": "#4c7a58", "color": "#24402c" },
    "constant": { "shape": "rect",    "fill": "#eaf2ec", "stroke": "#4c7a58", "color": "#24402c" },
    "number":     { "shape": "rect",    "fill": "#eaf2ec", "stroke": "#4c7a58", "color": "#24402c" },
    "expression": { "shape": "rect",    "fill": "#eaf2ec", "stroke": "#4c7a58", "color": "#24402c" },
    "text":       { "shape": "rect",    "fill": "#eaf2ec", "stroke": "#4c7a58", "color": "#24402c" },
    "operator":   { "shape": "circle",  "fill": "#e9eff3", "stroke": "#46718a", "color": "#1f3542" },
    "function": { "shape": "hexagon", "fill": "#e9eff3", "stroke": "#46718a", "color": "#1f3542" },
    "relation": { "shape": "diamond", "fill": "#f6eedb", "stroke": "#9a6d1c", "color": "#59400e" },
    "result":   { "shape": "stadium", "fill": "#f6eedb", "stroke": "#9a6d1c", "color": "#59400e" },
    "annotation": { "shape": "circle",  "fill": "#eef0ed", "stroke": "#8a958d", "color": "#4a534d" }
  },
  "edgeStyles": {
    "direct":  { "stroke": "#a8503f", "strokeWidth": 3 },
    "inverse": { "stroke": "#46718a", "strokeWidth": 1, "arrow": "-.->" },
    "neutral": { "stroke": "#68726b", "strokeWidth": 2 }
  },
  "paintBySemantic": true,
  "fontSize": 15
}
