  "nodeStyles": {
    "scalar":     { "shape": "circle",  "fill": "#2b2312", "stroke": "#d9a441", "color": "#ecd9ae" },
    "vector":     { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3", "strokeWidth": 2 },
    "matrix":     { "shape": "rect",    "fill": "#202a30", "stroke": "#7fa3b8", "color": "#d2e2ea", "strokeWidth": 2 },
    "number":     { "shape": "circle",  "fill": "#2b2312", "stroke": "#d9a441", "color": "#ecd9ae" },
    "expression": { "shape": "circle",  "fill": "#2b2312", "stroke": "#d9a441", "color": "#ecd9ae" },
    "text":       { "shape": "circle",  "fill": "#2b2312", "stroke": "#d9a441", "color": "#ecd9ae" },
    "constant":   { "shape": "circle",  "fill": "#2b2312", "stroke": "#d9a441", "color": "#ecd9ae" },
    "relation":   { "shape": "diamond", "fill": "#2c1d18", "stroke": "#c9705f", "color": "#e8c4ba" },
    "result":     { "shape": "stadium", "fill": "#162a26", "stroke": "#5fa08f", "color": "#bfe0d6" },
