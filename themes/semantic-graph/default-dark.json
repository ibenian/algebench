{
  "name": "default-dark",
  "mode": "dark",
  "direction": "RL",
  "labelMode": "emoji",
  "nodeStyles": {
    "scalar":   { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3" },
    "vector":   { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3" },
    "constant": { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3" },
    "number":     { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3" },
    "expression": { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3" },
    "text":       { "shape": "rect",    "fill": "#1d2b22", "stroke": "#7fae8a", "color": "#cfe3d3" },
    "operator":   { "shape": "circle",  "fill": "#202a30", "stroke": "#7fa3b8", "color": "#d2e2ea" },
    "function":   { "shape": "hexagon", "fill": "#202a30", "stroke": "#7fa3b8", "color": "#d2e2ea" },
    "relation":   { "shape": "diamond", "fill": "#2e2617", "stroke": "#d9a441", "color": "#ecd9ae" },
    "result":     { "shape": "stadium", "fill": "#2e2617", "stroke": "#d9a441", "color": "#ecd9ae" },
    "annotation": { "shape": "circle",  "fill": "#232a26", "stroke": "#6f7d73", "color": "#b9c2bb" }
  },
  "edgeStyles": {
    "direct":  { "stroke": "#c9705f", "strokeWidth": 3 },
    "inverse": { "stroke": "#7fa3b8", "strokeWidth": 1, "arrow": "-.->" },
    "neutral": { "stroke": "#97a29a", "strokeWidth": 2 }
  },
  "paintBySemantic": true,
  "fontSize": 15
}
