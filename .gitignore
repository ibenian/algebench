__pycache__/
*.pyc
*.pyo

# Dev-time-only Node tooling (type generation + typecheck). The app never
# runs Node — src/types/*.d.ts is generated and committed.
node_modules/
.venv/
venv/
.env
.env.local
.env.*.local
*.wav
*.m4a
settings.local.json

# Expert framework: generated datasets + compiled DSPy artifacts
/data/
backend/experts/modules/*/artifacts/

# Override global gitignore to include project-level agent skill definitions
!.agents/
!.claude/
.claude/settings.local.json
.claude/scheduled_tasks.lock
!AGENTS.md
!CLAUDE.md
# CocoIndex Code (ccc)
/.cocoindex_code/

# proof-animation report build output (report.py --outdir _site; regenerated in CI)
/_site/

# /prove page local proof store (user-derived proofs; never committed)
.proof-store/
.proof-source-material/
.vite/

# Generated report artifacts (published to gh-pages by CI, not committed)
LOC-REPORT.md
DEPENDENCY-AUDIT-REPORT.md
