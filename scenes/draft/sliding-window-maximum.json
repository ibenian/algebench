{
  "title": "Sliding Window Maximum (Knowledge Graph demo)",
  "glossary": {
    "sliding window": {
      "term": "Sliding window",
      "aliases": ["window"],
      "markdown": "A contiguous range of $k$ elements that moves one position at a time; each move adds one element on the right and drops one on the left."
    },
    "deque": {
      "term": "Deque",
      "aliases": ["double-ended queue"],
      "markdown": "A **double-ended queue**: insert and remove at both the front and the back in $O(1)$."
    },
    "monotonic deque": {"term": "Monotonic deque", "markdown": "A deque of array **indices** whose values are kept in decreasing order from front to back, so the front always holds the window's maximum."},
    "amortized analysis": {"term": "Amortized analysis", "markdown": "Bounding the **total** cost of a sequence of operations rather than the worst single operation — here, every index is pushed once and popped at most once."}
  },
