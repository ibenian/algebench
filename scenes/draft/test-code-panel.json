              "valueExpr": "arrayAt(arrayAfter(), idx)",
              "highlightExpr": "(idx >= arrayCount(arrayBefore()) ? 1 : (arrayAt(arrayAfter(), idx) != arrayAt(arrayBefore(), idx) ? 1 : (idx == dataTable('operations', operation, 'index') ? 1 : 0))) > 0",
              "label": "After",
              "labelOffset": [
                0,
                0.95,
                0
              ]
            },
            {
              "id": "ops-title",
              "type": "expression_label",
              "textExpr": "dataTable('operations', operation, 'title')",
              "position": [
                0,
                3,
                0
              ]
            },
            {
              "id": "ops-result",
              "type": "expression_label",
              "textExpr": "concat('result = ', arrayResult(arrayBefore(), dataTable('operations', operation, 'name'), dataTable('operations', operation, 'a'), dataTable('operations', operation, 'b')))",
              "position": [
                0,
                -2.3,
                0
              ]
            },
            {
              "id": "ops-length",
              "type": "expression_label",
              "textExpr": "concat('length = ', arrayCount(arrayAfter()))",
              "position": [
                0,
                -2.3,
                0
              ],
              "connectTo": {
                "object": "ops-after"
              }
            },
            {
              "id": "ops-empty",
              "type": "text",
              "text": "empty",
              "position": [
                -4,
                -0.6,
                0
              ],
              "visibleExpr": "arrayCount(arrayAfter()) == 0",
              "color": "#9dbde3"
            }
          ]
        }
      ],
      "stepPlayback": {
        "slider": "operation",
        "intervalMs": 1800
      }
    },
