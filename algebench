#!/bin/bash
# algebench launcher — auto-creates venv on first run, then starts the server.

DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$DIR/.venv"

# Venv provisioning lives in scripts/setup-venv.sh — one implementation, shared
# with run.sh. They used to hold near-identical copies, which is how the lockfile
# work in issue #593 landed in one and silently missed the other.
ensure_venv() {
    [ -x "$VENV/bin/python3" ] || "$DIR/scripts/setup-venv.sh" || exit 1
}

# --update: bump gemini-live-tools to its newest tag, then move every other
# dependency to the newest version requirements.txt allows. Both steps go
# so requirements.lock is regenerated — upgrading the venv
# without relocking would leave local dev ahead of CI and Render, which is
# exactly the drift issue #593 closed.
if [ "$1" = "--update" ]; then
    shift
    echo "🔍 Checking for latest gemini-live-tools..."
    LATEST=$(git ls-remote --tags --refs https://github.com/ibenian/gemini-live-tools.git 'v*' \
        | awk -F/ '{print $NF}' | sort -V | tail -1)
    if [ -n "$LATEST" ]; then
        CURRENT=$(grep 'gemini-live-tools' "$DIR/requirements.txt" | grep -o '@v[^#]*' | tr -d '@')
        if [ "$CURRENT" != "$LATEST" ]; then
            echo "⬆️  gemini-live-tools $CURRENT → $LATEST"
            sed -i '' "s|gemini-live-tools\.git@[^#]*|gemini-live-tools.git@$LATEST|" "$DIR/requirements.txt"
        else
            echo "✅ gemini-live-tools already at $LATEST"
        fi
    else
        echo "⚠️  Could not fetch latest tag, skipping"
    fi
    # Regenerate the lock — that is what actually gets installed. Upgrading the
    # venv without relocking would leave local dev ahead of CI and both deploys.
    # uv.toml's 30-day cooldown applies automatically; do not override it.
    echo "📦 Upgrading dependencies and regenerating requirements.lock..."
    uv pip compile "$DIR/requirements.txt" -o "$DIR/requirements.lock" \
        --universal --python-version 3.12 --no-header --upgrade || exit 1
    "$DIR/scripts/setup-venv.sh" >/dev/null || exit 1
    echo "⚠️  Read the version diff before committing — the cooldown can move a"
    echo "    package BACKWARDS if its pin is younger than 30 days."
    echo "✓ Update complete — review and commit:"
    echo "    git diff requirements.txt requirements.lock"
    exit 0
fi

ensure_venv

# Load gitignored secrets if present. Format: KEY=VALUE per line (shell syntax).
# Does not override values already set in the parent environment.
if [ -f "$DIR/.env.local" ]; then
    set -a
    . "$DIR/.env.local"
    set +a
fi

export PYTHONPATH="${DIR}${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python3" "$DIR/backend/server.py" "$@"
